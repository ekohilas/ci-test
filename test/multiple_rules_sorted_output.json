[
  {
    "jobs": [
      "job-rules-none"
    ]
  },
  {
    "if": "$CI_PIPELINE_SOURCE == 'merge_request_event'",
    "jobs": [
      "job-rules-if-changes"
    ]
  },
  {
    "changes": [
      "**/*.py"
    ],
    "jobs": [
      "job-rules-if-changes"
    ]
  },
  {
    "if": "$CI_PIPELINE_SOURCE == 'push'",
    "changes": [
      "**/*.py"
    ],
    "jobs": [
      "job-rules-if-changes"
    ]
  }
]